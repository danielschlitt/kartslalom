# Local development
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kartslalom
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Built dynamically by Makefile if not set
# DATABASE_URL=postgresql://postgres:password@localhost:5432/kartslalom

# Production (server)
PROJECT_NAME=kartslalom
FQDN=kartslalom.just-motorsport.de

# Token that unlocks the admin pages (/admin, /endlauf26/*/admin) and the
# mutating API routes. Falls back to "qwerty123" when unset.
ADMIN_TOKEN=change-me-to-a-random-token

# OpenAI — used for Whisper dictation of lap times in the Endlauf live timing and
# for reading photographed result sheets (OCR) in the admin pages
# (exported to the webapp by the Makefile when running `make dev`)
OPENAI_API_KEY=
# Optional: transcription model (default whisper-1; e.g. gpt-4o-mini-transcribe)
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Optional: chat model that turns the transcript into {timeSeconds, penaltySeconds} (default gpt-4o-mini)
OPENAI_EXTRACT_MODEL=gpt-4o-mini
# Optional: vision model that reads photographed result sheets (default gpt-5.6; e.g. gpt-5.6-terra, gpt-4o)
OPENAI_VISION_MODEL=gpt-5.6
