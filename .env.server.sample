# Production runtime — copy to .env.server and use strong secrets.
# Only this file is copied to the server (not .env or .env.build).

PROJECT_NAME=kartslalom
FQDN=kartslalom.just-motorsport.de

POSTGRES_DB=kartslalom
POSTGRES_USER=kartslalom
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Token that unlocks the admin pages (/admin, /endlauf26/*/admin) and the
# mutating API routes. Falls back to "qwerty123" when unset.
ADMIN_TOKEN=change-me-to-a-random-token

# OpenAI — Whisper dictation of lap times in the Endlauf live timing (/endlauf26/*/admin)
OPENAI_API_KEY=sk-...
# Optional transcription model (default whisper-1)
OPENAI_TRANSCRIBE_MODEL=whisper-1
