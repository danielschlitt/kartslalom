# Production runtime — copy to .env.server and use strong secrets.
# Only this file is copied to the server (not .env or .env.build).

PROJECT_NAME=kartslalom
FQDN=kartslalom.just-motorsport.de

POSTGRES_DB=kartslalom
POSTGRES_USER=kartslalom
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Token that unlocks the admin pages (/admin, /endlauf26/*/admin) and the
# mutating API routes. Falls back to "qwerty123" when unset.
ADMIN_TOKEN=change-me-to-a-random-token

# OpenAI — Whisper dictation of lap times in the Endlauf live timing (/endlauf26/*/admin)
# and OCR of photographed result sheets in the admin pages
OPENAI_API_KEY=sk-...
# Optional transcription model (default whisper-1)
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Optional chat model that turns the transcript into {timeSeconds, penaltySeconds} (default gpt-4o-mini)
OPENAI_EXTRACT_MODEL=gpt-4o-mini
# Optional vision model that reads photographed result sheets (default gpt-5.6)
OPENAI_VISION_MODEL=gpt-5.6
# Optional chat model that phrases the "AI Prediction" on the Endlauf driver page
# (default gpt-5.6)
OPENAI_PREDICTION_MODEL=gpt-5.6
